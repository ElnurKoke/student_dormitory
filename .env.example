# Defaults work without a .env file. Load this file explicitly as shown in README.
HTTP_ADDR=localhost:8080
DATABASE_PATH=var/dormitory.db
# Private storage: photos are in FILES_DIR/photos; use one directory per database.
FILES_DIR=var/files
SHUTDOWN_TIMEOUT=10s
APP_ENV=development
DEV_LOGIN_ENABLED=false
# With DEV_LOGIN_ENABLED=true, startup creates five test roles after migrations.
# Defaults to dev-users.txt next to DATABASE_PATH. Never commit this file.
DEV_USERS_FILE=var/dev-users.txt
SESSION_TTL=8h
# Demo data is explicit and development-only: go run ./cmd/demo-data -out var/demo
# Stop the server before go run ./cmd/backup create -out NEW_DIRECTORY.
# A restored bundle uses NEW_DIRECTORY/dormitory.db and NEW_DIRECTORY/files.

# Own NCANode API v3. Empty disables EDS login; never use a public demo verifier.
# Start it with: docker compose -f compose.ncanode.yaml up -d --wait
# Then set http://127.0.0.1:14579 and launch ./scripts/run-local.sh.
NCANODE_URL=
# Exact public origin included in each one-time login challenge (no trailing /).
# Production requires HTTPS; do not derive it from proxy headers.
EDS_ORIGIN=http://localhost:8080
